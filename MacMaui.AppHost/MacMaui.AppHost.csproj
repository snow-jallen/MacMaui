<Project Sdk="Aspire.AppHost.Sdk/13.5.3">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Application, not a library: keep it out of `dotnet pack`. -->
    <IsPackable>false</IsPackable>
    <AspireUseCliBundle>true</AspireUseCliBundle>
    <UserSecretsId>8ff9b5c4-e1fb-4629-8e8a-075f6cc1f51f</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MacMaui.ApiService\MacMaui.ApiService.csproj" />
    <ProjectReference Include="..\MacMaui.Web\MacMaui.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.DevTunnels" Version="13.5.3" />
    <PackageReference Include="Aspire.Hosting.Maui" Version="13.5.3-preview.1.26425.3" />
  </ItemGroup>

</Project>
