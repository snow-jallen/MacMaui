* text=auto

# Xcode Cloud runs these on macOS; a CR after the shebang breaks them.
*.sh          text eol=lf
*.pbxproj     text eol=lf
*.xcscheme    text eol=lf
*.plist       text eol=lf
*.xcprivacy   text eol=lf

*.ps1         text eol=crlf
*.sln         text eol=crlf

*.png binary
*.ttf binary
*.ico binary
