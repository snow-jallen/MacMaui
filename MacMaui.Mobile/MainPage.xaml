<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:cl="clr-namespace:MacMaui.ClientLogic;assembly=MacMaui.ClientLogic"
             x:Class="MacMaui.Mobile.MainPage"
             x:DataType="cl:WeatherViewModel"
             Title="MacMaui">

    <Grid Padding="24"
          RowSpacing="16"
          RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">

        <!-- "MacMaui" is the template's sourceName, so this shows the name the app was
             generated with, e.g. Public3 or Demo5. -->
        <Label Grid.Row="0"
               Text="MacMaui"
               FontSize="28"
               FontAttributes="Bold"
               HorizontalOptions="Center"
               SemanticProperties.HeadingLevel="Level1" />

        <!-- Stepper rather than a text box: the value has a sensible range and this keeps it
             inside it without any validation code or a keyboard on mobile. -->
        <HorizontalStackLayout Grid.Row="1" Spacing="12" HorizontalOptions="Center">
            <Label Text="Days"
                   VerticalOptions="Center"
                   FontSize="16" />
            <Stepper Minimum="1"
                     Maximum="30"
                     Increment="1"
                     Value="{Binding Days}"
                     SemanticProperties.Description="Number of forecast days to request"
                     VerticalOptions="Center" />
            <Label Text="{Binding Days}"
                   FontAttributes="Bold"
                   FontSize="16"
                   WidthRequest="32"
                   VerticalOptions="Center" />
        </HorizontalStackLayout>

        <Button Grid.Row="2"
                Text="Get Weather"
                FontSize="18"
                HeightRequest="56"
                HorizontalOptions="Fill"
                SemanticProperties.Hint="Calls the weather API and shows the forecast"
                Command="{Binding LoadWeatherCommand}" />

        <HorizontalStackLayout Grid.Row="3" Spacing="10">
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               HeightRequest="18"
                               WidthRequest="18"
                               VerticalOptions="Center" />
            <Label Text="{Binding Status}"
                   VerticalOptions="Center" />
        </HorizontalStackLayout>

        <CollectionView Grid.Row="4"
                        ItemsSource="{Binding Forecasts}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="cl:WeatherForecast">
                    <Border Margin="0,4"
                            Padding="14"
                            StrokeShape="RoundRectangle 10"
                            StrokeThickness="1">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="{Binding Date}"
                                       FontAttributes="Bold"
                                       FontSize="16" />
                                <Label Text="{Binding Summary}"
                                       FontSize="14"
                                       Opacity="0.75" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1"
                                   Text="{Binding TemperatureC, StringFormat='{0}°C'}"
                                   FontSize="22"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Windows only; hidden elsewhere from code-behind, since iOS updates through
             TestFlight and Android through a new APK. Visible so a demo does not have to wait
             for the background check to come round. -->
        <Button x:Name="CheckUpdatesButton"
                Grid.Row="5"
                Text="Check for updates"
                FontSize="13"
                HeightRequest="36"
                HorizontalOptions="Center"
                IsVisible="False"
                SemanticProperties.Hint="Asks whether a newer version of this app is available"
                Clicked="OnCheckUpdatesClicked" />

    </Grid>

</ContentPage>
