<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
		<!-- CI builds one platform on a machine that has only that platform's workload:
		       dotnet publish -p:SingleTargetFramework=net10.0-android   (GitHub Actions, .github/workflows/release.yml)
		       dotnet build   -p:SingleTargetFramework=net10.0-ios       (Xcode Cloud, XcodeCloud/ci_scripts/ci_post_clone.sh)
		     Restore then asks for that workload alone. Unset, the list above stands. -->
		<TargetFrameworks Condition="'$(SingleTargetFramework)' != ''">$(SingleTargetFramework)</TargetFrameworks>
		<!-- A device build, not a simulator build. Set here rather than on the command line because a
		     global RuntimeIdentifier would also be handed to the referenced class libraries. -->
		<RuntimeIdentifier Condition="'$(SingleTargetFramework)' == 'net10.0-ios'">ios-arm64</RuntimeIdentifier>

		<!-- Note for MacCatalyst:
		The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
		When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
		The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
		either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
		<!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

		<OutputType>Exe</OutputType>
		<RootNamespace>MacMaui.Mobile</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<!-- MAUI app, not a library. Packing also fails outright: ios/maccatalyst/windows
		     build into RID subfolders, so Pack looks for runtimeconfig.json in the bare
		     TFM folder and errors with NU5026. -->
		<IsPackable>false</IsPackable>

		<!-- Enable XAML source generation for faster build times and improved performance.
		     This generates C# code from XAML at compile time instead of runtime inflation.
		     To disable, remove this line.
		     For individual files, you can override by setting Inflator metadata:
		       <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
		       <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<!-- Display name -->
		<ApplicationTitle>MacMaui.Mobile</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>edu.snow.macmaui.mobile</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
		<WindowsPackageType>None</WindowsPackageType>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />
		
		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<!-- Windows only. Velopack gives the unpackaged desktop build an installer and background
	     auto-update, which .NET MAUI has no equivalent of (there is no ClickOnce here). The
	     other platforms update through their stores: TestFlight on iOS, a new APK on Android. -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
		<PackageReference Include="Velopack" Version="1.2.0" />
	</ItemGroup>

	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
		<!-- Take over the entry point so Velopack runs before any UI. Its install and update
		     hooks re-run the executable and must finish before WinUI starts, which is why the
		     generated Main will not do. See Platforms/Windows/Program.cs.
		     Set UseCustomWindowsEntryPoint=false to fall back to the generated Main, which is
		     useful for isolating a startup problem. -->
		<UseCustomWindowsEntryPoint Condition="'$(UseCustomWindowsEntryPoint)' == ''">true</UseCustomWindowsEntryPoint>
		<DefineConstants Condition="'$(UseCustomWindowsEntryPoint)' == 'true'">$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
		<!-- Where the app looks for updates. A public GitHub repository needs no credentials;
		     override with -p:UpdateFeedUrl=... to publish from somewhere else. -->
		<UpdateFeedUrl Condition="'$(UpdateFeedUrl)' == ''">https://github.com/snow-jallen/MacMaui</UpdateFeedUrl>
	</PropertyGroup>

	<ItemGroup Condition="'$(UseCustomWindowsEntryPoint)' != 'true'">
		<Compile Remove="Platforms\Windows\Program.cs" />
	</ItemGroup>

	<ItemGroup Condition="'$(UpdateFeedUrl)' != ''">
		<AssemblyMetadata Include="UpdateFeedUrl" Value="$(UpdateFeedUrl)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
	</ItemGroup>

	<!-- Release builds made outside Aspire have no environment telling the app where the API is, so the
	     build bakes it in: dotnet publish -p:ApiBaseUrl=https://your-api.azurewebsites.net
	     MauiProgram.cs reads this attribute and registers it as the service discovery entry for "apiservice". -->
	<ItemGroup Condition="'$(ApiBaseUrl)' != ''">
		<AssemblyMetadata Include="ApiBaseUrl" Value="$(ApiBaseUrl)" />
	</ItemGroup>

	<!-- Where a released build sends its telemetry. Same mechanism as ApiBaseUrl: there is no
	     Aspire dashboard outside development, so the OTLP destination travels in the binary.
	     Anyone with the app can read these, which is why OpenObserve keeps a fixed retention
	     window and sits behind an account you can rotate.
	         dotnet publish -p:OtlpEndpoint=https://.../api/default \
	                        -p:OtlpHeaders="Authorization=Basic ..." -->
	<ItemGroup Condition="'$(OtlpEndpoint)' != ''">
		<AssemblyMetadata Include="OtlpEndpoint" Value="$(OtlpEndpoint)" />
		<AssemblyMetadata Include="OtlpHeaders" Value="$(OtlpHeaders)" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\MacMaui.ClientLogic\MacMaui.ClientLogic.csproj" />
	  <ProjectReference Include="..\MacMaui.MauiServiceDefaults\MacMaui.MauiServiceDefaults.csproj" />
	</ItemGroup>

</Project>
